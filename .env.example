# Copy to .env — placeholders only. Never commit .env or real secrets.
# Rotation runbook: plan section 4.15 (JWT_SECRETS every 6 months; DB/Redis passwords annually).

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password
POSTGRES_DB=qms_db

QMS_MIGRATOR_PASSWORD=change-me-migrator-password
QMS_APP_PASSWORD=change-me-app-password

DATABASE_URL="postgresql://qms_app:change-me-app-password@postgres:5432/qms_db?schema=public&connection_limit=10&pool_timeout=10"
MIGRATE_DATABASE_URL="postgresql://qms_migrator:change-me-migrator-password@postgres:5432/qms_db?schema=public"

REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379

# Comma-separated for rotation: current,previous (minimum 32 bytes each). Verify uses both; sign uses current only.
JWT_SECRETS=change-me-generate-at-least-32-bytes-base64
COOKIE_SECURE=true

# Public browser origin (same-origin topology), e.g. https://qms.example.com
PUBLIC_ORIGIN=https://qms.example.com

# Docker nginx is the only proxy by default; use 2 only when host nginx also fronts the stack (see ssl.example.conf).
TRUST_PROXY_HOPS=1

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="QMS <noreply@example.com>"

SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=change-me-bootstrap-admin

HTTP_PORT=80
HTTPS_PORT=443
NGINX_SSL_DIR=./nginx/ssl
# Docker edge config: qms.conf (TLS in container) or qms.http.conf (host TLS — use with docker-compose.host-tls.override.yml)
NGINX_EDGE_CONF=./nginx/qms.conf

# Dev only (docker-compose.dev.yml): host apps use these
# DATABASE_URL=postgresql://qms_app:...@127.0.0.1:5433/qms_db?schema=public
# REDIS_URL=redis://:...@127.0.0.1:6379
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025

# Daily backup via host cron: avoid 02:15, 03:40, 06:30 (app cron jobs, plan 10.10)
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_WEEKS=8
# Optional offsite copy (disabled until you set a path): BACKUP_OFFSITE_DIR=/mnt/backup-sync/qms
# AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GPG_RECIPIENT=ops@example.com